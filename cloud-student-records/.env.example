# Copy to .env for local development:  Copy-Item .env.example .env
# NEVER put AWS access keys or secret keys in this file or in source code.

# ---- LOCAL MODE (default) ----
STORAGE_BACKEND=sqlite
# Optional custom path (default: .data/students.db)
# SQLITE_PATH=.data/students.db

# ---- AWS MODE (used on EC2 via systemd, not normally locally) ----
# STORAGE_BACKEND=dynamodb
# DYNAMODB_TABLE_NAME=StudentRecords
# AWS_DEFAULT_REGION=ap-south-1

# Signs flash-message cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

LOG_LEVEL=INFO
